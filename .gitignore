# ---- Referentes: material de otros sitios, no se sube ----
referentes/capturas/*
referentes/videos/*
!referentes/capturas/.gitkeep
!referentes/videos/.gitkeep

# ---- Fábrica: estado local del lanzador y registros sin tarea ----
fabrica/.tarea-activa.json
fabrica/.herramientas-sin-tarea.jsonl
# Registro del hook (lleva comandos con rutas locales) y scripts temporales de los agentes
fabrica/datos/hook.jsonl
fabrica/buzon/*/tmp/
# Hojas «referente | nuestro» y cuadros del analista: llevan capturas de otros sitios (como referentes/capturas/)
fabrica/buzon/*/capturas/comparacion/
fabrica/buzon/*/referente/

# ---- Sitio ----
sitio/node_modules/
sitio/dist/
sitio/.astro/
sitio/test-results/
sitio/playwright-report/

# ---- Sistema ----
.env
.env.*
desktop.ini
Thumbs.db
.DS_Store

# ---- Material previo al encargo (prototipo del artifact, estrategia, capturas viejas) ----
# Se consulta en el arranque; no se sube hasta que el encargo decida qué se queda.
previo/
