---
import '@fontsource/dm-serif-text/latin-400.css';
import '@fontsource/dm-serif-text/latin-400-italic.css';
import '@fontsource/rubik-bubbles/latin-400.css';
import '../styles/fuentes.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Pie from '../components/Pie.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Páginas internas (el panel del equipo) que los buscadores no deben listar. */
  noindex?: boolean;
}

const {
  titulo = 'Convocatoria Algora',
  descripcion = 'Convocatoria del semillero Algora (Creación Digital, Universidad El Bosque) para estudiantes de cualquier carrera.',
  noindex = false,
} = Astro.props;

// Rutas con BASE_URL; la URL absoluta solo existe si hay `site` (en local no lo hay y no rompe)
const base = import.meta.env.BASE_URL;
const imagenRedes = Astro.site ? new URL(`${base}og.jpg`, Astro.site).href : `${base}og.jpg`;
const canonica = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {canonica && <link rel="canonical" href={canonica} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenRedes} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenRedes} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Aplica el tema guardado antes de pintar, para evitar el parpadeo -->
    <script is:inline>
      // La clase `js` hace que la precarga exista solo si hay JavaScript (respaldo en CSS, docs/2-TECNICO § 2)
      document.documentElement.classList.add('js');
      try {
        var t = localStorage.getItem('algora-tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <Nav />
    <slot />
    <Pie />
    <script>
      import '../lib/movimiento';
      import { iniciarListo } from '../lib/listo';
      iniciarListo();
    </script>
  </body>
</html>
