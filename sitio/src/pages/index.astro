---
import Base from '../layouts/Base.astro';
import Precarga from '../components/Precarga.astro';
import Portada from '../components/Portada.astro';
import Hitos from '../components/Hitos.astro';
import Productos from '../components/Productos.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Carreras from '../components/Carreras.astro';
import Proyectos from '../components/Proyectos.astro';
import Postulacion from '../components/Postulacion.astro';
---
<Base>
  <Precarga />
  <main>
    <Portada />
    <Hitos />
    <Productos />
    <ComoFunciona />
    <Carreras />
    <Proyectos />
    <Postulacion />
  </main>
</Base>

<script>
  import { iniciarPortada } from '../lib/portada';
  import { iniciarHitos } from '../lib/hitos';
  import { iniciarProductos } from '../lib/productos';
  import { iniciarProyectos } from '../lib/helice';
  import { iniciarRevelar } from '../lib/revelar';
  iniciarPortada();
  iniciarHitos();
  iniciarProductos();
  iniciarProyectos();
  iniciarRevelar();
</script>
