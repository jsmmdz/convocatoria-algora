---
import { inicio } from '../lib/rutas';
---
<nav class="nav" aria-label="Principal">
  <a class="nav__logo" href={inicio} aria-label="algora, ir al inicio">algora</a>
  <div class="nav__acciones">
    <button class="nav__boton" id="tema" type="button" aria-label="Cambiar tema">Tema</button>
    <a class="nav__boton nav__boton--cta" href={`${inicio}#postulate`}>Postúlate</a>
  </div>
</nav>

<script>
  import { conectarBotonTema } from '../lib/tema';
  conectarBotonTema();
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--capa-nav);
    min-height: var(--alto-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gutter);
    padding: var(--espacio-s) var(--margen);
    background: var(--fondo);
    border-bottom: var(--borde-ancho) solid var(--borde);
  }
  .nav__logo {
    font-family: var(--fuente-acento);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--texto);
    text-decoration: none;
  }
  .nav__acciones {
    display: flex;
    align-items: center;
    gap: var(--gutter);
  }
  .nav__boton {
    font-family: var(--fuente-etiqueta);
    font-size: var(--texto-etiqueta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    padding: 0.5rem 1rem;
    color: var(--texto);
    background: var(--superficie);
    border: var(--borde-ancho) solid var(--borde);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    transition: transform var(--dur-rapida) var(--curva-salida), box-shadow var(--dur-rapida) var(--curva-salida);
  }
  .nav__boton:hover {
    transform: translate(2px, 2px);
    box-shadow: var(--sombra-hover);
  }
  /* Bloque de marca: igual en claro y oscuro */
  .nav__boton--cta {
    background: var(--color-acido);
    color: var(--color-tinta);
    font-weight: 600;
  }
</style>
