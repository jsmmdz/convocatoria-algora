---
import Mascota from './Mascota.astro';
---
<!-- Precarga (unseen A1): solo existe con JS (clase `js`); el script la anima, el CSS la oculta sola a los 3,5 s -->
<div class="precarga" data-precarga aria-hidden="true">
  <Mascota />
  <p class="precarga__cuenta" data-precarga-cuenta>[0%]</p>
</div>

<style>
  .precarga {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--capa-precarga);
    place-content: center;
    justify-items: center;
    gap: var(--precarga-espacio);
    background: var(--color-tinta);
    color: var(--color-papel);
    /* Respaldo: si el JS no llega, la capa se va sola cuando se cumple el tiempo máximo */
    animation: precarga-respaldo var(--precarga-fundido) var(--curva-salida) var(--precarga-respaldo) forwards;
  }
  :global(.js) .precarga { display: grid; }
  .precarga__cuenta {
    margin: 0;
    font-family: var(--fuente-etiqueta);
    font-size: var(--texto-etiqueta);
    letter-spacing: 0.14em;
  }
  @keyframes precarga-respaldo {
    to { opacity: 0; visibility: hidden; }
  }
  /* Con movimiento reducido no se muestra nunca */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .precarga { display: none; }
  }
</style>
